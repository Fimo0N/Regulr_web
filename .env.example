# --- Core ---
PORT=3000
# Public URL of this server. NFC tags and Google Wallet links point here.
PUBLIC_URL=http://localhost:3000
DATABASE_URL="file:./dev.db"
# Long random string. Required in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Lets you sign in with just an email while developing. NEVER enable in production.
DEV_LOGIN=true

# --- Google Sign-In (customers + store owners) ---
# OAuth client ID (type "Web application") from Google Cloud Console.
GOOGLE_CLIENT_ID=

# --- Google Wallet (optional: without it, customers still get the web card) ---
# Issuer ID from https://pay.google.com/business/console
GOOGLE_WALLET_ISSUER_ID=
# Path to the service account JSON key that was added as a user on the issuer account.
GOOGLE_WALLET_KEY_FILE=./secrets/wallet-service-account.json

# --- NTAG 424 DNA (production NFC cards, optional) ---
# 32 hex chars each (AES-128). The meta key decrypts the tag's UID + counter,
# the master key derives each card's file key (see `npm run tag:key`).
SUN_META_KEY=
SUN_MASTER_KEY=

# --- Frontend ---
# Your public website (Vercel), used for the privacy policy link in the app.
VITE_WEBSITE_URL=
